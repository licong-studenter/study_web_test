# Canonical URL of the published site (no trailing slash).
# Leave empty locally; GitHub Actions derives it from GITHUB_REPOSITORY.
PUBLIC_SITE_URL=

# Base path for a GitHub Pages project site, e.g. /embodied-ai-lab.
# Leave empty for a custom domain or a <owner>.github.io repository.
PUBLIC_BASE_PATH=

# Optional: link shown in the header and footer.
PUBLIC_GITHUB_URL=https://github.com/DeepRoboticsLab
