---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="页面未找到" noindex pageType="notFound">
  <div class="shell notfound">
    <div>
      <div class="lost-xiaoju" aria-hidden="true">
        <svg viewBox="0 0 180 180" fill="none">
          <defs>
            <radialGradient id="lost-orb" cx=".34" cy=".25" r=".84">
              <stop stop-color="#F4FBFF" />
              <stop offset=".24" stop-color="#A9D2FF" />
              <stop offset=".6" stop-color="#4D8EFF" />
              <stop offset="1" stop-color="#173A9F" />
            </radialGradient>
          </defs>
          <ellipse cx="90" cy="158" rx="46" ry="8" fill="#2F67E8" opacity=".14" />
          <ellipse cx="90" cy="90" rx="72" ry="34" stroke="#5C8BFF" stroke-opacity=".35" stroke-dasharray="3 8" transform="rotate(-16 90 90)" />
          <circle cx="90" cy="90" r="52" fill="url(#lost-orb)" />
          <circle cx="90" cy="90" r="52" stroke="#D7EEFF" stroke-opacity=".7" />
          <ellipse cx="72" cy="78" rx="23" ry="10" fill="#FFFFFF" opacity=".3" transform="rotate(-28 72 78)" />
          <ellipse cx="72" cy="88" rx="7" ry="9" fill="#FFFFFF" />
          <ellipse cx="108" cy="88" rx="7" ry="9" fill="#FFFFFF" />
          <ellipse cx="73" cy="89" rx="3.5" ry="5" fill="#142C66" />
          <ellipse cx="109" cy="89" rx="3.5" ry="5" fill="#142C66" />
          <path d="M80 111c6 4 13 4 19 0" stroke="#142C66" stroke-width="2.2" stroke-linecap="round" />
          <circle cx="26" cy="90" r="3" fill="#35D7F0" />
          <circle cx="154" cy="89" r="2.5" fill="#A77BFF" />
        </svg>
        <span>信号丢失了…</span>
      </div>
      <div class="code">404</div>
      <h1>这条控制指令没有对应的话题</h1>
      <p>页面可能已移动，或者链接写错了。回到课程目录继续探索。</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase('/courses/')}>返回课程矩阵</a>
        <a class="btn btn-ghost" href={withBase('/')}>回到首页</a>
      </div>
    </div>
  </div>
</BaseLayout>
