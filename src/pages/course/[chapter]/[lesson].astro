---
import LegacyRedirect from '../../../components/LegacyRedirect.astro';
import { getEntry } from 'astro:content';
import { lessonSlug, publishedLessons } from '../../../lib/content';

export async function getStaticPaths() {
  const lessons = await publishedLessons();
  return lessons.map((lesson) => ({
    params: {
      chapter: lesson.data.chapter,
      lesson: lessonSlug(lesson),
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const chapter = await getEntry('chapters', lesson.data.chapter);
if (!chapter) throw new Error(`Chapter not found for lesson ${lesson.id}`);
---
<LegacyRedirect
  to={`/courses/${chapter.data.course}/${chapter.id}/${lessonSlug(lesson)}/`}
  title={`${lesson.data.title} · 页面已迁移`}
/>
