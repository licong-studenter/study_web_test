---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Callout from '../../../components/Callout.astro';
import Figure from '../../../components/Figure.astro';
import RepoCard from '../../../components/RepoCard.astro';
import Quiz from '../../../components/Quiz';
import { getEntry, render } from 'astro:content';
import {
  lessonSlug,
  lessonsForChapter,
  publishedCases,
  publishedLessons,
} from '../../../lib/content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const lessons = await publishedLessons();
  return lessons.map((lesson) => ({
    params: {
      chapter: lesson.data.chapter,
      lesson: lessonSlug(lesson),
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const chapter = await getEntry('chapters', lesson.data.chapter);
if (!chapter) throw new Error(`Chapter not found for lesson ${lesson.id}`);

const chapterLessons = await lessonsForChapter(lesson.data.chapter);
const index = chapterLessons.findIndex((item) => item.id === lesson.id);
const previous = index > 0 ? chapterLessons[index - 1] : undefined;
const next = index < chapterLessons.length - 1 ? chapterLessons[index + 1] : undefined;
const quiz = await getEntry('quizzes', lesson.id);
const cases = await publishedCases();
const relatedCase = cases.find((item) => item.data.chapter === lesson.data.chapter);

const { Content, headings } = await render(lesson);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const description = lesson.data.summary;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const durationMinutes = lesson.data.duration.match(/\d+/)?.[0];
---
<BaseLayout title={lesson.data.title} description={description} ogType="article">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LearningResource',
      name: lesson.data.title,
      description,
      url: canonical,
      inLanguage: 'zh-CN',
      learningResourceType: 'Lesson',
      educationalLevel: chapter.data.level,
      timeRequired: durationMinutes ? `PT${durationMinutes}M` : undefined,
      isPartOf: {
        '@type': 'Course',
        name: chapter.data.title,
      },
      provider: {
        '@type': 'Organization',
        name: 'Embodied AI Lab',
      },
    })}
  />

  <div class="shell lesson-shell">
    <aside class="lesson-side">
      <span class="side-label">CH.{String(chapter.data.order).padStart(2, '0')}</span>
      <a class="side-chapter" href={withBase(`/course/${chapter.id}/`)}>{chapter.data.title}</a>
      <nav class="side-list" aria-label="本章目录">
        {
          chapterLessons.map((item) => (
            <a
              href={withBase(`/course/${chapter.id}/${lessonSlug(item)}/`)}
              aria-current={item.id === lesson.id ? 'page' : undefined}
            >
              {String(item.data.order).padStart(2, '0')} {item.data.title}
            </a>
          ))
        }
      </nav>
      <div class="side-progress">
        LESSON {String(lesson.data.order).padStart(2, '0')} / {String(chapterLessons.length).padStart(2, '0')}
        <br />
        预计 {lesson.data.duration}
      </div>
    </aside>

    <article class="lesson-main">
      <header class="lesson-head">
        <div class="breadcrumbs">
          <a href={withBase('/course/')}>课程</a>
          <span class="sep">/</span>
          <a href={withBase(`/course/${chapter.id}/`)}>第 {chapter.data.order} 章</a>
          <span class="sep">/</span>
          <span>第 {lesson.data.order} 节</span>
        </div>
        <h1>{lesson.data.title}</h1>
        <p class="summary">{lesson.data.summary}</p>
        <div class="page-meta">
          <span class="chip accent">{lesson.data.duration}</span>
          <span class="chip">教材正文</span>
          <span class="chip cyan">3 道测验</span>
        </div>
        <ul class="lesson-objectives">
          {lesson.data.objectives.map((objective) => <li>{objective}</li>)}
        </ul>
      </header>

      <div class="prose">
        <Content components={{ Callout, Figure, RepoCard }} />
      </div>

      {quiz && <Quiz questions={quiz.data.questions} client:idle />}

      {
        relatedCase && (
          <a
            class="repo-card"
            href={withBase(`/cases/${relatedCase.id}/`)}
            style="margin-top:40px"
          >
            <span>
              <strong>配套实训 · {relatedCase.data.title}</strong>
              <span>{relatedCase.data.summary}</span>
            </span>
            <span class="ext">LAB</span>
          </a>
        )
      }

      <nav class="lesson-nav" aria-label="课时导航">
        {
          previous ? (
            <a href={withBase(`/course/${chapter.id}/${lessonSlug(previous)}/`)}>
              <span class="dir">← PREVIOUS</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : (
            <a href={withBase(`/course/${chapter.id}/`)}>
              <span class="dir">← BACK</span>
              <strong>返回章节总览</strong>
            </a>
          )
        }
        {
          next ? (
            <a class="next" href={withBase(`/course/${chapter.id}/${lessonSlug(next)}/`)}>
              <span class="dir">NEXT →</span>
              <strong>{next.data.title}</strong>
            </a>
          ) : (
            <a class="next" href={withBase('/course/')}>
              <span class="dir">NEXT →</span>
              <strong>返回课程目录</strong>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="toc" aria-label="页内目录">
      <h2>ON THIS PAGE</h2>
      <ol>
        {
          toc.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} class={heading.depth === 3 ? 'depth-3' : ''}>
                {heading.text}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>

  <script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    const targets = links
      .map((link) => {
        const id = decodeURIComponent(link.getAttribute('href')?.slice(1) || '');
        return { link, element: id ? document.getElementById(id) : null };
      })
      .filter((item) => item.element);

    if (targets.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach((link) => link.classList.remove('active'));
            const match = targets.find((item) => item.element === entry.target);
            match?.link.classList.add('active');
          }
        },
        { rootMargin: '-18% 0px -70% 0px' },
      );
      targets.forEach((item) => observer.observe(item.element as Element));
    }

    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy-code')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = 'COPY';
      button.setAttribute('aria-label', '复制代码');
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent || pre.textContent || '';
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = 'COPIED';
        } catch {
          button.textContent = 'FAILED';
        }
        window.setTimeout(() => {
          button.textContent = 'COPY';
        }, 1400);
      });
      pre.appendChild(button);
    });
  </script>
</BaseLayout>
