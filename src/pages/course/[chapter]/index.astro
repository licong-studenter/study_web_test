---
import LegacyRedirect from '../../../components/LegacyRedirect.astro';
import { publishedChapters } from '../../../lib/content';

export async function getStaticPaths() {
  const chapters = await publishedChapters();
  return chapters.map((chapter) => ({
    params: { chapter: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
---
<LegacyRedirect
  to={`/courses/${chapter.data.course}/${chapter.id}/`}
  title={`${chapter.data.title} · 页面已迁移`}
/>
