---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { publishedCases } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const cases = await publishedCases();
  return cases.map((item) => ({
    params: { case: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const chapter = await getEntry('chapters', item.data.chapter);
const { Content } = await render(item);
const cases = await publishedCases();
const index = cases.findIndex((entry) => entry.id === item.id);
const next = cases[index + 1];
---
<BaseLayout title={item.data.title} description={item.data.summary} ogType="article">
  <section class="page-hero">
    <div class="shell">
      <div class="breadcrumbs">
        <a href={withBase('/cases/')}>实训项目</a>
        <span class="sep">/</span>
        <span>LAB.{String(item.data.order).padStart(2, '0')}</span>
      </div>
      <h1>{item.data.title}</h1>
      <p>{item.data.summary}</p>
      <div class="page-meta">
        <span class="chip accent">{item.data.difficulty}</span>
        <span class="chip">{item.data.duration}</span>
        <span class="chip">{item.data.hardware}</span>
        {chapter && (
          <a class="chip cyan" href={withBase(`/course/${chapter.id}/`)}>
            第 {chapter.data.order} 章 · {chapter.data.title}
          </a>
        )}
      </div>
    </div>
  </section>

  <div class="shell detail-grid">
    <article class="prose" style="padding-top:0">
      <Content />
      {next && (
        <div style="margin-top:44px;padding-top:24px;border-top:1px solid var(--line)">
          <a class="link-arrow" href={withBase(`/cases/${next.id}/`)}>
            下一个实训：{next.data.title}
          </a>
        </div>
      )}
    </article>

    <aside class="detail-aside">
      <div class="aside-card">
        <h2>项目目标</h2>
        <ul>{item.data.objectives.map((objective) => <li>{objective}</li>)}</ul>
      </div>
      <div class="aside-card">
        <h2>交付物</h2>
        <ul>{item.data.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
      </div>
      {
        item.data.repos.length > 0 && (
          <div class="aside-card">
            <h2>相关仓库</h2>
            <ul style="margin-top:12px">
              {item.data.repos.map((repo) => (
                <li style="padding-left:0">
                  <a href={repo.url} target="_blank" rel="noreferrer" style="color:var(--cyan);font-family:var(--font-mono);font-size:11px;word-break:break-all">
                    {repo.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="aside-card">
        <h2>安全边界</h2>
        <ul>
          <li>真机操作前确认急停可用，保持安全距离。</li>
          <li>首次运行先架空或降低增益，再落地测试。</li>
          <li>修改控制参数时一次只改一个变量。</li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
