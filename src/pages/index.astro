---
import BaseLayout from '../layouts/BaseLayout.astro';
import XiaojuHero from '../components/xiaoju/XiaojuHero.astro';
import ChapterIcon from '../components/ChapterIcon.astro';
import {
  publishedChapters,
  publishedCourses,
  publishedLessons,
} from '../lib/content';
import { withBase } from '../lib/url';

const courses = await publishedCourses();
const chapters = await publishedChapters();
const lessons = await publishedLessons();
const courseCards = courses.map((course) => {
  const courseChapters = chapters.filter((chapter) => chapter.data.course === course.id);
  const chapterIds = new Set(courseChapters.map((chapter) => chapter.id));
  return {
    course,
    chapters: courseChapters,
    lessonCount: lessons.filter((lesson) => chapterIds.has(lesson.data.chapter)).length,
  };
});

const overview = [
  { label: '课程方向', value: String(courses.length).padStart(2, '0'), unit: '门' },
  { label: '教材正文', value: String(lessons.length).padStart(2, '0'), unit: '节' },
  { label: '知识测验', value: String(lessons.length * 3).padStart(2, '0'), unit: '题' },
  { label: '交互实验', value: '06', unit: '个' },
];

const path = [
  {
    num: '01',
    title: '建立系统认知',
    desc: '从具身智能的基础概念出发，认识感知、决策、执行与学习四层结构，并跑通 Lite3 仿真。',
    meta: 'FOUNDATIONS',
  },
  {
    num: '02',
    title: '掌握反馈语言',
    desc: '用传递函数、时域、频域与状态空间分析系统，判断稳定性、响应速度与控制余量。',
    meta: 'AUTOMATIC CONTROL',
  },
  {
    num: '03',
    title: '让身体运动',
    desc: '从刚体动力学与关节驱动进入步态、WBC、MPC 和学习型运动，把指令变成可执行接触。',
    meta: 'MOTION CONTROL',
  },
  {
    num: '04',
    title: '让模型决策',
    desc: '用世界模型、模仿学习、VLA、强化学习、估计与规划，把观测变成有依据的行动。',
    meta: 'EMBODIED ALGORITHMS',
  },
  {
    num: '05',
    title: '回到真实系统',
    desc: '在算法实验室验证直觉，在仿真中压测，再沿安全边界迁移到真机与综合项目。',
    meta: 'LABS + DEPLOYMENT',
  },
];

const repos = [
  {
    label: 'DeepRoboticsLab/Lite3_ROS',
    desc: 'UDP 与 ROS 2 消息桥接，感知主机开发入口。',
    url: 'https://github.com/DeepRoboticsLab/Lite3_ROS',
  },
  {
    label: 'DeepRoboticsLab/rl_training',
    desc: '基于 Isaac Lab 的 Lite3 强化学习训练环境。',
    url: 'https://github.com/DeepRoboticsLab/rl_training',
  },
  {
    label: 'DeepRoboticsLab/Lite3_MotionSDK',
    desc: 'MPC 运动控制实现与双主机通信示例。',
    url: 'https://github.com/DeepRoboticsLab/Lite3_MotionSDK',
  },
  {
    label: 'DeepRoboticsLab/Lite3_rl_deploy',
    desc: 'MuJoCo sim-to-sim 与真机策略部署链路。',
    url: 'https://github.com/DeepRoboticsLab/Lite3_rl_deploy',
  },
  {
    label: 'DeepRoboticsLab/Robot_Training_Cases',
    desc: 'Lite3 实训案例集，从连接、仿真到导航与 LLM。',
    url: 'https://github.com/DeepRoboticsLab/Robot_Training_Cases',
  },
  {
    label: 'DeepRoboticsLab/deep_robotics_model',
    desc: 'Lite3 的 URDF / MJCF / USD 机器人模型。',
    url: 'https://github.com/DeepRoboticsLab/deep_robotics_model',
  },
];
---
<BaseLayout
  pageType="home"
  title="具身智能学习站"
  description="Embodied AI Lab：4 门课程、20 个模块、60 节正文与 180 道测验，覆盖具身基础、自动控制、运动控制与具身模型算法。"
>
  <section class="hero shell">
    <div class="hero-copy" data-reveal>
      <span class="eyebrow">EMBODIED AI · FOUR TRACKS · SIM-TO-REAL</span>
      <h1>
        让智能
        <span class="outline">走进物理世界</span>
      </h1>
      <p class="hero-lede">
        四门课程，从反馈与控制到运动与具身模型。先建立系统认知，再用公式、交互实验与仿真把每一个结论验证到能动起来。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase('/courses/')} data-page-turn="forward">
          探索课程矩阵
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn-ghost" href={withBase('/algorithms/')} data-page-turn="forward">打开算法实验室</a>
      </div>
      <div class="hero-stats">
        {
          overview.map((item) => (
            <div class="hero-stat">
              <strong>{item.value}<span style="font-size:10px;color:var(--muted-2);margin-left:4px">{item.unit}</span></strong>
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="hero-visual" data-reveal style="--reveal-delay: 100ms">
      <XiaojuHero />
    </div>
  </section>

  <section class="home-section shell" id="path" data-reveal>
    <div class="section-head">
      <div>
        <span class="eyebrow cyan">LEARNING PATH</span>
        <h2>一条从系统认知到真机交付的主线</h2>
      </div>
      <p>基础课建立全貌，三门进阶课分别深化控制、运动与模型算法。每个阶段都配公式、代码、测验与可交互实验。</p>
    </div>
    <div class="path-track">
      {
        path.map((step, index) => (
          <div class="path-step" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <span class="path-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
            <span class="mono">{step.meta}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section shell" id="curriculum" data-reveal>
    <div class="section-head">
      <div>
        <span class="eyebrow">CURRICULUM MATRIX</span>
        <h2>四门课程，构成完整的具身学习体系</h2>
      </div>
      <a class="link-arrow" href={withBase('/courses/')} data-page-turn="forward">
        查看课程矩阵
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
    <div class="home-course-grid">
      {
        courseCards.map(({ course, chapters: courseChapters, lessonCount }, index) => (
          <article
            class="home-course-card"
            style={`--course-accent: ${course.data.accent}; --reveal-delay: ${index * 70}ms`}
            data-reveal
          >
            <div class="home-course-top">
              <span class="home-course-index">0{course.data.order}</span>
              <span class="home-course-kicker">{course.data.subtitle}</span>
              <ChapterIcon name={courseChapters[0]?.id || course.id} size={28} />
            </div>
            <h3><a href={withBase(`/courses/${course.id}/`)} data-page-turn="forward">{course.data.title}</a></h3>
            <p>{course.data.summary}</p>
            <div class="home-course-stats">
              <span><b>{courseChapters.length}</b> 模块</span>
              <span><b>{lessonCount}</b> 节</span>
              <span><b>{lessonCount * 3}</b> 题</span>
            </div>
            <div class="home-course-modules">
              {courseChapters.map((chapter) => (
                <a href={withBase(`/courses/${course.id}/${chapter.id}/`)} data-page-turn="forward">
                  <ChapterIcon name={chapter.id} size={18} />
                  {chapter.data.title}
                </a>
              ))}
            </div>
            <div class="home-course-foot">
              <span>{course.data.duration}</span>
              <a href={withBase(`/courses/${course.id}/`)} data-page-turn="forward">开始学习 →</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="home-section shell" data-reveal>
    <div class="section-head">
      <div>
        <span class="eyebrow">PIPELINE</span>
        <h2>仿真先行，真机验证</h2>
      </div>
      <p>把昂贵的试错放在仿真里，把有限的上机时间留给系统联调与真实世界的噪声。</p>
    </div>
    <div class="pipeline" data-reveal>
      <div class="pipeline-node">
        <span class="mono">01 / SIMULATE</span>
        <h3>在仿真中建模</h3>
        <p>加载 URDF / MJCF，构建地形、传感器与动力学场景，快速迭代控制参数。</p>
        <ul>
          <li>MuJoCo 单关节验证</li>
          <li>Isaac Lab 并行训练</li>
        </ul>
      </div>
      <div class="pipeline-arrow">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="pipeline-node">
        <span class="mono">02 / VALIDATE</span>
        <h3>用指标做判断</h3>
        <p>对比步态周期、跟踪误差、能耗与鲁棒性，先在 sim-to-sim 中暴露问题。</p>
        <ul>
          <li>ONNX 策略导出</li>
          <li>扰动与地形泛化</li>
        </ul>
      </div>
      <div class="pipeline-arrow">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="pipeline-node">
        <span class="mono">03 / DEPLOY</span>
        <h3>让身体承担智能</h3>
        <p>部署到运动主机与感知主机，处理通信、时延、安全边界与现场故障。</p>
        <ul>
          <li>双主机联调</li>
          <li>安全操作与运维</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section shell" id="ecosystem" data-reveal>
    <div class="section-head">
      <div>
        <span class="eyebrow cyan">OPEN SOURCE</span>
        <h2>站在真实的开源工程上学习</h2>
      </div>
      <p>课程中的每个关键概念，都对应一个可克隆、可运行、可拆解的仓库。</p>
    </div>
    <div class="repo-strip">
      {
        repos.map((repo, index) => (
          <a
            class="repo-mini"
            href={repo.url}
            target="_blank"
            rel="noreferrer"
            data-reveal
            style={`--reveal-delay: ${index * 55}ms`}
          >
            <span class="mono">OFFICIAL REPO</span>
            <strong>{repo.label}</strong>
            <span>{repo.desc}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section shell" data-reveal>
    <div class="section-head">
      <div>
        <span class="eyebrow">ALGORITHM PLAYGROUND</span>
        <h2>把公式拖起来，再回去读理论</h2>
      </div>
      <a class="link-arrow" href={withBase('/algorithms/')} data-page-turn="forward">
        进入算法实验室
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
    <div class="algo-teaser">
      <div>
        <span class="mono">INTERACTIVE / REAL-TIME</span>
        <h3>六个小实验，建立控制与算法的直觉。</h3>
        <p>调整 PID、拖动足端目标、观察 Kalman 与 PPO，再用 MPC 看约束下的未来，用 A* 看搜索如何展开。</p>
      </div>
      <div class="algo-teaser-grid">
        <span>PID 闭环</span>
        <span>二连杆 IK</span>
        <span>卡尔曼滤波</span>
        <span>PPO 裁剪</span>
        <span>MPC 滚动优化</span>
        <span>A* 网格规划</span>
      </div>
    </div>
  </section>

  <section class="shell" style="padding-bottom:90px" data-reveal>
    <div class="cta-band">
      <div>
        <h2>从“知道”到“会判断”，再到“能让它动”。</h2>
        <p>从具身智能基础开始，选一条进阶路线，把公式、代码、仿真与真实系统连成一条可验证的路径。</p>
      </div>
      <a class="btn btn-primary" href={withBase('/courses/foundations/')} data-page-turn="forward">
        进入基础课程
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
