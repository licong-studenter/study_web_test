---
import '../styles/global.css';
import '../styles/bright.css';
import 'katex/dist/katex.min.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import SearchPalette from '../components/SearchPalette';
import IntroSequence from '../components/IntroSequence.astro';
import RevealObserver from '../components/RevealObserver.astro';
import XiaojuPet from '../components/xiaoju/XiaojuPet.astro';
import PageTransition from '../components/PageTransition.astro';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  noindex?: boolean;
  activeNav?: string;
  bodyClass?: string;
  wide?: boolean;
  pageType?: 'home' | 'courses' | 'course' | 'chapter' | 'lesson' | 'case' | 'algorithms' | 'notFound' | 'admin';
}

const {
  title,
  description = 'Embodied AI Lab 具身智能学习站：四门课程覆盖具身基础、自动控制、运动控制与具身模型算法，配有 180 道测验和交互算法实验。',
  ogType = 'website',
  noindex = false,
  bodyClass = '',
  pageType = 'home',
} = Astro.props;

const siteName = 'Embodied AI Lab';
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · 具身智能学习站`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const siteRoot = Astro.site ? new URL(withBase('/'), Astro.site).href : Astro.url.href;
const ogImage = new URL(withBase('/og.png'), Astro.site ?? Astro.url).href;
const csp = import.meta.env.PROD
  ? "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self'"
  : '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const force = new URLSearchParams(window.location.search).has('intro');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let seen = false;
        try {
          seen = window.sessionStorage.getItem('xiaoju:intro') === '1';
        } catch {
          seen = false;
        }
        document.documentElement.dataset.intro = reduce ? 'off' : force || !seen ? 'on' : 'off';
      })();
    </script>
    <noscript>
      <style>
        .intro-root { display: none !important; }
        html, body { overflow: auto !important; }
      </style>
    </noscript>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content={pageType === 'admin' ? '#0A0C10' : '#F7F9FE'} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: siteRoot,
      description,
      inLanguage: 'zh-CN',
    })} />
  </head>
  <body class={`${bodyClass}${pageType !== 'admin' ? ' theme-bright' : ''}`} data-page={pageType}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    {pageType !== 'admin' && <PageTransition />}
    {pageType !== 'admin' && <IntroSequence />}
    <ScrollProgress />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {pageType !== 'admin' && <XiaojuPet />}
    <RevealObserver />
    <SearchPalette client:load base={import.meta.env.BASE_URL} />
  </body>
</html>
