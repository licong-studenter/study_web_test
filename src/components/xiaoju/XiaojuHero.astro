<div class="xj-hero-orb" data-xj-orb>
  <div class="xj-orb-bubble" data-xj-line>
    <span class="xj-orb-bubble-kicker">小具 · XJ-01 / BLUE CORE</span>
    <strong>博士，今天想从哪门课开始？</strong>
  </div>

  <button class="xj-orb-button" type="button" aria-label="小具，点击让它跳一下">
    <span class="xj-orb-shadow" aria-hidden="true"></span>
    <svg class="xj-orb-svg" viewBox="0 0 460 460" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <radialGradient id="xjo-hero-body" cx=".34" cy=".26" r=".82">
          <stop stop-color="#F4FBFF" />
          <stop offset=".18" stop-color="#A9D2FF" />
          <stop offset=".52" stop-color="#4D8EFF" />
          <stop offset=".82" stop-color="#2F67E8" />
          <stop offset="1" stop-color="#173A9F" />
        </radialGradient>
        <radialGradient id="xjo-hero-highlight" cx=".5" cy=".5" r=".5">
          <stop stop-color="#FFFFFF" stop-opacity=".9" />
          <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="xjo-hero-ring" x1="80" y1="220" x2="380" y2="220" gradientUnits="userSpaceOnUse">
          <stop stop-color="#35D7F0" stop-opacity=".12" />
          <stop offset=".5" stop-color="#5C8BFF" stop-opacity=".8" />
          <stop offset="1" stop-color="#A77BFF" stop-opacity=".18" />
        </linearGradient>
        <filter id="xjo-hero-glow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="12" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="xjo-hero-soft" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="18" />
        </filter>
      </defs>

      <ellipse cx="230" cy="388" rx="128" ry="26" fill="#2F67E8" opacity=".12" filter="url(#xjo-hero-soft)" />
      <g class="xjo-orbit xjo-orbit-back">
        <ellipse cx="230" cy="230" rx="182" ry="88" stroke="url(#xjo-hero-ring)" stroke-width="1.2" stroke-dasharray="4 10" transform="rotate(-18 230 230)" />
        <ellipse cx="230" cy="230" rx="156" ry="140" stroke="#8B8DFF" stroke-opacity=".22" stroke-width="1" transform="rotate(24 230 230)" />
      </g>
      <g class="xjo-spark xjo-spark-a"><circle cx="88" cy="146" r="4" fill="#35D7F0" /></g>
      <g class="xjo-spark xjo-spark-b"><circle cx="378" cy="294" r="3" fill="#A77BFF" /></g>
      <g class="xjo-spark xjo-spark-c"><circle cx="342" cy="102" r="2.5" fill="#5C8BFF" /></g>

      <g class="xjo-core">
        <circle cx="230" cy="230" r="132" fill="url(#xjo-hero-body)" />
        <circle cx="230" cy="230" r="132" stroke="#BFE2FF" stroke-opacity=".65" stroke-width="1.4" />
        <ellipse cx="186" cy="164" rx="58" ry="30" fill="url(#xjo-hero-highlight)" opacity=".55" transform="rotate(-28 186 164)" />
        <circle cx="230" cy="230" r="132" stroke="#FFFFFF" stroke-opacity=".13" stroke-width="18" />

        <g class="xjo-eyes">
          <ellipse cx="186" cy="224" rx="19" ry="25" fill="#FFFFFF" />
          <ellipse cx="274" cy="224" rx="19" ry="25" fill="#FFFFFF" />
          <ellipse cx="188" cy="226" rx="10" ry="15" fill="#142C66" />
          <ellipse cx="276" cy="226" rx="10" ry="15" fill="#142C66" />
          <circle cx="183" cy="218" r="4" fill="#FFFFFF" />
          <circle cx="271" cy="218" r="4" fill="#FFFFFF" />
          <circle cx="194" cy="236" r="2.5" fill="#35D7F0" />
          <circle cx="282" cy="236" r="2.5" fill="#35D7F0" />
        </g>
        <g class="xjo-happy" opacity="0">
          <path d="M168 226c7-10 15-13 25-8M257 218c10-5 18-2 25 8" stroke="#142C66" stroke-width="4" stroke-linecap="round" />
        </g>
        <path d="M216 274c9 8 19 8 28 0" stroke="#142C66" stroke-width="3.4" stroke-linecap="round" />
        <ellipse cx="158" cy="258" rx="17" ry="8" fill="#FF9BB5" opacity=".3" />
        <ellipse cx="302" cy="258" rx="17" ry="8" fill="#FF9BB5" opacity=".3" />
        <path d="M150 196c5-7 12-10 21-9M289 187c9-1 16 2 21 9" stroke="#FFFFFF" stroke-opacity=".4" stroke-width="3" stroke-linecap="round" />
      </g>

      <g class="xjo-orbit xjo-orbit-front">
        <ellipse cx="230" cy="230" rx="178" ry="62" stroke="#5C8BFF" stroke-opacity=".36" stroke-width="1" transform="rotate(14 230 230)" />
        <circle cx="84" cy="224" r="5" fill="#35D7F0" filter="url(#xjo-hero-glow)" />
        <circle cx="376" cy="236" r="4" fill="#A77BFF" filter="url(#xjo-hero-glow)" />
      </g>
    </svg>
  </button>

  <div class="xj-orb-tag" aria-hidden="true">
    <span>BLUE CORE</span>
    <span>CLICK TO BOUNCE</span>
  </div>
</div>

<script>
  const orb = document.querySelector<HTMLElement>('[data-xj-orb]');
  const line = orb?.querySelector<HTMLElement>('[data-xj-line] strong');
  const lines = [
    '博士，今天想从哪门课开始？',
    '点我一下，我会跳起来。',
    '公式看不懂？去算法实验室拖动参数试试。',
  ];
  let index = 0;
  let jumpTimer = 0;

  orb?.querySelector('.xj-orb-button')?.addEventListener('click', () => {
    orb.classList.add('is-jumping', 'is-happy');
    index = (index + 1) % lines.length;
    if (line) line.textContent = lines[index];
    window.clearTimeout(jumpTimer);
    jumpTimer = window.setTimeout(() => orb.classList.remove('is-jumping', 'is-happy'), 720);
  });
</script>
