<script>
  const hero = document.querySelector<HTMLElement>('[data-xiaoju-hero]');
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  const bubbleLine = hero?.querySelector<HTMLElement>('[data-xj-line]');
  const lines = [
    '博士，今天想从哪一章开始？',
    '数字孪生已上线，可以拖动看看。',
    '先读概念，再让机器狗走两步。',
  ];
  let lineIndex = 0;
  let happyTimer = 0;

  if (hero && stage) {
    let frame = 0;
    stage.addEventListener('pointermove', (event) => {
      if (window.matchMedia('(pointer: coarse)').matches) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const rect = stage.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        hero.style.setProperty('--xj-look-x', `${x * 10}px`);
        hero.style.setProperty('--xj-look-y', `${y * 7}px`);
      });
    });
    stage.addEventListener('pointerleave', () => {
      hero.style.setProperty('--xj-look-x', '0px');
      hero.style.setProperty('--xj-look-y', '0px');
    });
  }

  hero?.addEventListener('click', () => {
    hero.classList.add('is-happy');
    lineIndex = (lineIndex + 1) % lines.length;
    if (bubbleLine) bubbleLine.textContent = lines[lineIndex];
    window.clearTimeout(happyTimer);
    happyTimer = window.setTimeout(() => hero.classList.remove('is-happy'), 1100);

    const layer = hero.querySelector('.xj-hero-heart-layer');
    if (!layer) return;
    for (let index = 0; index < 4; index += 1) {
      const heart = document.createElement('span');
      heart.className = 'xj-hero-heart';
      heart.style.setProperty('--heart-x', `${-34 + Math.random() * 68}px`);
      heart.style.setProperty('--heart-delay', `${index * 80}ms`);
      layer.appendChild(heart);
      window.setTimeout(() => heart.remove(), 1300);
    }
  });
</script>
