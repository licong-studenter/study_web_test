<div class="xj-pet" id="xiaoju-pet" data-xj-pet>
  <div class="xj-pet-bubble" id="xj-pet-bubble" role="status" aria-live="polite" hidden>
    <button class="xj-pet-close" type="button" aria-label="关闭小具的提示">×</button>
    <span class="xj-pet-bubble-kicker">小具 / XIAOJU TIP</span>
    <strong data-xj-pet-line></strong>
  </div>

  <button class="xj-pet-button" type="button" aria-label="小具：点击跳跃，按住拖动" aria-expanded="false" aria-controls="xj-pet-bubble">
    <span class="xj-pet-shadow" aria-hidden="true"></span>
    <svg class="xj-pet-svg" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <radialGradient id="xjo-pet-body" cx=".34" cy=".25" r=".84">
          <stop stop-color="#F4FBFF" />
          <stop offset=".2" stop-color="#A9D2FF" />
          <stop offset=".55" stop-color="#4D8EFF" />
          <stop offset=".84" stop-color="#2F67E8" />
          <stop offset="1" stop-color="#173A9F" />
        </radialGradient>
        <linearGradient id="xjo-pet-ring" x1="36" y1="110" x2="184" y2="110" gradientUnits="userSpaceOnUse">
          <stop stop-color="#35D7F0" stop-opacity=".15" />
          <stop offset=".5" stop-color="#5C8BFF" stop-opacity=".7" />
          <stop offset="1" stop-color="#A77BFF" stop-opacity=".2" />
        </linearGradient>
        <filter id="xjo-pet-glow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      <ellipse cx="110" cy="190" rx="40" ry="8" fill="#2F67E8" opacity=".14" />
      <g class="xjo-pet-orbit">
        <ellipse cx="110" cy="110" rx="91" ry="43" stroke="url(#xjo-pet-ring)" stroke-width="1" stroke-dasharray="3 8" transform="rotate(-15 110 110)" />
        <ellipse cx="110" cy="110" rx="73" ry="77" stroke="#8B8DFF" stroke-opacity=".18" transform="rotate(23 110 110)" />
      </g>
      <g class="xjo-pet-core">
        <circle cx="110" cy="110" r="64" fill="url(#xjo-pet-body)" />
        <circle cx="110" cy="110" r="64" stroke="#D2EBFF" stroke-opacity=".6" stroke-width="1.2" />
        <ellipse cx="88" cy="80" rx="27" ry="14" fill="#FFFFFF" opacity=".3" transform="rotate(-28 88 80)" />
        <g class="xjo-pet-eyes">
          <ellipse cx="89" cy="106" rx="9" ry="12" fill="#FFFFFF" />
          <ellipse cx="131" cy="106" rx="9" ry="12" fill="#FFFFFF" />
          <ellipse cx="90" cy="107" rx="4.5" ry="7" fill="#142C66" />
          <ellipse cx="132" cy="107" rx="4.5" ry="7" fill="#142C66" />
          <circle cx="87" cy="102" r="1.8" fill="#FFFFFF" />
          <circle cx="129" cy="102" r="1.8" fill="#FFFFFF" />
        </g>
        <g class="xjo-pet-happy" opacity="0">
          <path d="M80 106c4-6 9-7 14-4M118 102c5-3 10-2 14 4" stroke="#142C66" stroke-width="2.5" stroke-linecap="round" />
        </g>
        <path d="M103 128c5 5 11 5 16 0" stroke="#142C66" stroke-width="2.4" stroke-linecap="round" />
        <ellipse cx="73" cy="121" rx="8" ry="4" fill="#FF9BB5" opacity=".35" />
        <ellipse cx="147" cy="121" rx="8" ry="4" fill="#FF9BB5" opacity=".35" />
      </g>
      <circle cx="29" cy="110" r="3.2" fill="#35D7F0" filter="url(#xjo-pet-glow)" />
      <circle cx="191" cy="108" r="2.6" fill="#A77BFF" filter="url(#xjo-pet-glow)" />
    </svg>
  </button>

  <span class="xj-pet-drag-hint">拖动我</span>
</div>

<script>
  const pet = document.getElementById('xiaoju-pet');
  const bubble = document.getElementById('xj-pet-bubble');
  const bubbleLine = pet?.querySelector<HTMLElement>('[data-xj-pet-line]');
  const button = pet?.querySelector<HTMLButtonElement>('.xj-pet-button');
  const close = pet?.querySelector<HTMLButtonElement>('.xj-pet-close');

  const dialogue: Record<string, string[]> = {
    home: ['欢迎来到具身智能实验室，博士。', '点我跳一下，或者拖动我到别处。', '想先理解概念，还是直接去算法实验室？'],
    course: ['四门课程路线已经加载完成。', '第一次来建议从具身智能基础开始。', '想补控制去自动控制理论，想深入模型去算法课程。'],
    chapter: ['这一章的重点已经写在学习目标里。', '先看结构，再看公式，会轻松很多。', '配套实训在页面下方。'],
    lesson: ['读到公式时别急，先看变量定义。', '三题测验在页面底部，做完再走。', '算法实验室可以把参数拖起来看。'],
    case: ['真机操作前，先确认急停可用。', '第一次运行请低速、低增益。', '失败记录比成功视频更有价值。'],
    algorithms: ['这里是算法游乐场。', '拖一拖参数，看看曲线怎么变。', '先观察现象，再回去读公式。'],
    notFound: ['这里没有信号，我带你回课程目录。', '页面可能被移动了。', '先回到首页重新导航吧。'],
  };

  let lineIndex = 0;
  let hideTimer = 0;

  function lines() {
    return dialogue[document.body.dataset.page || 'home'] || dialogue.home;
  }

  function placeBubble() {
    if (!pet || !bubble) return;
    const rect = pet.getBoundingClientRect();
    const width = Math.min(258, window.innerWidth - 28);
    if (rect.left < width * 0.72) {
      bubble.style.left = '0';
      bubble.style.right = 'auto';
    } else {
      bubble.style.left = 'auto';
      bubble.style.right = '0';
    }
    if (rect.top < 210) {
      bubble.style.top = 'calc(100% + 12px)';
      bubble.style.bottom = 'auto';
      bubble.style.borderRadius = '4px 18px 18px 18px';
    } else {
      bubble.style.top = 'auto';
      bubble.style.bottom = 'calc(100% + 12px)';
      bubble.style.borderRadius = '18px 18px 4px 18px';
    }
  }

  function speak(text?: string) {
    if (!pet || !bubble || !bubbleLine) return;
    if (!text) {
      const all = lines();
      text = all[lineIndex % all.length];
      lineIndex += 1;
    }
    bubbleLine.textContent = text;
    bubble.hidden = false;
    button?.setAttribute('aria-expanded', 'true');
    pet.classList.add('is-talking');
    placeBubble();
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => {
      if (!bubble) return;
      bubble.hidden = true;
      button?.setAttribute('aria-expanded', 'false');
      pet.classList.remove('is-talking');
    }, 6800);
  }

  function jump() {
    if (!pet) return;
    pet.classList.remove('is-jumping', 'is-happy');
    void pet.offsetWidth;
    pet.classList.add('is-jumping', 'is-happy');
    window.setTimeout(() => pet.classList.remove('is-jumping', 'is-happy'), 700);
  }

  let dragging = false;
  let moved = false;
  let startX = 0;
  let startY = 0;
  let startLeft = 0;
  let startTop = 0;
  let pointerId = -1;

  function clampPosition(left: number, top: number) {
    const width = pet?.offsetWidth || 96;
    const height = pet?.offsetHeight || 96;
    return {
      left: Math.max(8, Math.min(window.innerWidth - width - 8, left)),
      top: Math.max(8, Math.min(window.innerHeight - height - 8, top)),
    };
  }

  function savePosition() {
    if (!pet) return;
    try {
      sessionStorage.setItem(
        'xiaoju:position',
        JSON.stringify({ left: parseFloat(pet.style.left), top: parseFloat(pet.style.top) }),
      );
    } catch {
      // Ignore storage restrictions.
    }
  }

  function restorePosition() {
    if (!pet) return;
    try {
      const saved = JSON.parse(sessionStorage.getItem('xiaoju:position') || 'null');
      if (saved && Number.isFinite(saved.left) && Number.isFinite(saved.top)) {
        const next = clampPosition(saved.left, saved.top);
        pet.style.left = `${next.left}px`;
        pet.style.top = `${next.top}px`;
        pet.style.right = 'auto';
        pet.style.bottom = 'auto';
      }
    } catch {
      // Ignore malformed storage.
    }
  }

  button?.addEventListener('pointerdown', (event) => {
    if (!pet || event.button !== 0) return;
    const rect = pet.getBoundingClientRect();
    dragging = true;
    moved = false;
    pointerId = event.pointerId;
    startX = event.clientX;
    startY = event.clientY;
    startLeft = rect.left;
    startTop = rect.top;
    pet.style.left = `${rect.left}px`;
    pet.style.top = `${rect.top}px`;
    pet.style.right = 'auto';
    pet.style.bottom = 'auto';
    pet.classList.add('is-dragging');
    button.setPointerCapture(event.pointerId);
  });

  button?.addEventListener('pointermove', (event) => {
    if (!dragging || !pet || event.pointerId !== pointerId) return;
    const dx = event.clientX - startX;
    const dy = event.clientY - startY;
    if (Math.abs(dx) + Math.abs(dy) > 5) moved = true;
    const next = clampPosition(startLeft + dx, startTop + dy);
    pet.style.left = `${next.left}px`;
    pet.style.top = `${next.top}px`;
  });

  const endDrag = (event: PointerEvent) => {
    if (!dragging || !pet || event.pointerId !== pointerId) return;
    dragging = false;
    pet.classList.remove('is-dragging');
    try {
      button?.releasePointerCapture(event.pointerId);
    } catch {
      // Pointer capture may already be released.
    }
    if (moved) savePosition();
    else {
      jump();
      speak();
    }
  };

  button?.addEventListener('pointerup', endDrag);
  button?.addEventListener('pointercancel', endDrag);

  close?.addEventListener('click', () => {
    if (!bubble) return;
    bubble.hidden = true;
    button?.setAttribute('aria-expanded', 'false');
    pet?.classList.remove('is-talking');
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && bubble) {
      bubble.hidden = true;
      button?.setAttribute('aria-expanded', 'false');
      pet?.classList.remove('is-talking');
    }
  });

  window.addEventListener('resize', () => {
    if (!pet || pet.style.left === '') return;
    const next = clampPosition(parseFloat(pet.style.left), parseFloat(pet.style.top));
    pet.style.left = `${next.left}px`;
    pet.style.top = `${next.top}px`;
  });

  window.addEventListener('xiaoju:speak', (event) => {
    const detail = (event as CustomEvent<{ text?: string }>).detail;
    if (detail?.text) speak(detail.text);
  });

  restorePosition();
</script>
