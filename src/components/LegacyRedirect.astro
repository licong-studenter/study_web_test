---
import { withBase } from '../lib/url';

interface Props {
  to: string;
  title?: string;
}

const { to, title = '页面已迁移' } = Astro.props;
const target = withBase(to);
const canonical = new URL(target, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>{title} · Embodied AI Lab</title>
    <meta name="theme-color" content="#f7f9fe" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: radial-gradient(circle at 70% 20%, #e8f1ff, transparent 45%), #f8fbff;
        color: #10213f;
        font-family: system-ui, sans-serif;
      }
      a { color: #2f6bff; }
      main { max-width: 520px; padding: 32px; text-align: center; }
    </style>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <main>
      <p>课程结构已升级，正在前往新的课程页面。</p>
      <p><a href={target}>如果没有自动跳转，请点击这里</a></p>
    </main>
  </body>
</html>
