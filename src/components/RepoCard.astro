---
const { label, url, meta = '' } = Astro.props;
---
<a class="repo-card" href={url} target="_blank" rel="noreferrer">
  <span>
    <strong>{label}</strong>
    {meta && <span>{meta}</span>}
  </span>
  <span class="ext">
    GITHUB
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
