---
const { type = 'note', title } = Astro.props;
const labels = {
  concept: '关键概念',
  engineering: '工程提示',
  safety: '安全提示',
  note: '备注',
};
const icons = {
  concept: '<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4l2.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  engineering: '<path d="M14.5 6.5 9 12l5.5 5.5M20 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  safety: '<path d="M12 3 3.5 19h17L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 9v4M12 16.2v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  note: '<path d="M5 4h14v16H5z" stroke="currentColor" stroke-width="1.5"/><path d="M8 9h8M8 13h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
};
const label = title || labels[type as keyof typeof labels] || labels.note;
---
<aside class={`callout ${type}`}>
  <div class="callout-head">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={icons[type as keyof typeof icons] || icons.note} />
    <span>{label}</span>
  </div>
  <div class="callout-body"><slot /></div>
</aside>
