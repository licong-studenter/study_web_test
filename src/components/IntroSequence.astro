<div class="intro-root" id="intro-root" role="presentation">
  <div class="intro-panel intro-panel-left" aria-hidden="true"></div>
  <div class="intro-panel intro-panel-right" aria-hidden="true"></div>
  <div class="intro-grid" aria-hidden="true"></div>
  <div class="intro-scan" aria-hidden="true"></div>

  <div class="intro-core">
    <div class="intro-kicker">EMBODIED AI LAB / BOOT SEQUENCE</div>
    <div class="intro-mark" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none">
        <rect x="12" y="24" width="40" height="18" rx="2" stroke="currentColor" stroke-width="1.3" />
        <path d="M18 24 13 12M46 24l5-12M18 42 13 54M46 42l5 12" stroke="currentColor" stroke-width="1.3" />
        <circle cx="13" cy="12" r="2" fill="currentColor" />
        <circle cx="51" cy="12" r="2" fill="currentColor" />
        <circle cx="13" cy="54" r="2" fill="currentColor" />
        <circle cx="51" cy="54" r="2" fill="currentColor" />
        <path d="M25 33h14" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </div>
    <div class="intro-title">小具正在醒来</div>
    <div class="intro-mascot" aria-hidden="true">
      <svg viewBox="0 0 180 220" fill="none">
        <path d="M38 92c0-38 25-61 55-61s54 25 54 64c0 44-24 72-55 72-32 0-54-28-54-75Z" fill="#141B26" stroke="#FF6A2B" stroke-opacity=".7" stroke-width="1.4" />
        <path d="M55 91c2-21 18-35 38-35 21 0 36 14 38 36-8-8-17-13-29-14-8 14-20 23-37 26l-10-13Z" fill="#283346" />
        <circle cx="71" cy="102" r="7" fill="#FFB45C" />
        <circle cx="111" cy="102" r="7" fill="#FFB45C" />
        <path d="M83 129c5 4 11 4 16 0" stroke="#41EAD4" stroke-width="2" stroke-linecap="round" />
        <circle cx="37" cy="106" r="9" fill="#0D1118" stroke="#41EAD4" stroke-width="1.2" />
        <circle cx="143" cy="106" r="9" fill="#0D1118" stroke="#41EAD4" stroke-width="1.2" />
        <path d="M143 97V72" stroke="#FF6A2B" stroke-width="1.5" />
        <circle cx="143" cy="69" r="4" fill="#FF6A2B" />
        <path d="M70 163c-4 11-12 17-22 18M110 163c4 11 12 17 22 18" stroke="#41EAD4" stroke-opacity=".45" stroke-width="1.4" />
      </svg>
    </div>
    <div class="intro-copy">
      <span>INITIALIZING CORE</span>
      <span>CALIBRATING SENSORS</span>
      <span>SYNCING DIGITAL TWIN</span>
    </div>
    <div class="intro-meter"><span></span></div>
    <div class="intro-readout">
      <span>UNIT XJ-01</span>
      <span>12 DOF / ONLINE</span>
    </div>
  </div>

  <button class="intro-skip" type="button">
    跳过
    <kbd>ESC</kbd>
  </button>
</div>

<script>
  const intro = document.getElementById('intro-root');
  const root = document.documentElement;
  const body = document.body;

  if (intro && root.dataset.intro === 'on') {
    let finished = false;
    const storageKey = 'xiaoju:intro';
    const finish = () => {
      if (finished) return;
      finished = true;
      try {
        sessionStorage.setItem(storageKey, '1');
      } catch {
        // Storage can be unavailable in private mode; the animation still ends.
      }
      root.removeAttribute('style');
      root.classList.remove('intro-active');
      body.classList.remove('intro-active');
      body.classList.add('intro-done');
      intro.classList.add('is-skipping');
      window.dispatchEvent(new CustomEvent('xiaoju:intro-done'));
      window.setTimeout(() => {
        root.dataset.intro = 'off';
        intro.remove();
      }, 520);
    };

    root.classList.add('intro-active');
    body.classList.add('intro-active');
    root.style.overflow = 'hidden';

    const timer = window.setTimeout(finish, 2350);
    const skip = () => {
      window.clearTimeout(timer);
      finish();
    };

    intro.querySelector('.intro-skip')?.addEventListener('click', skip);
    intro.addEventListener('click', skip);
    const onKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' && event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      window.removeEventListener('keydown', onKey);
      skip();
    };
    window.addEventListener('keydown', onKey);
  } else {
    intro?.remove();
    body.classList.add('intro-done');
  }
</script>
